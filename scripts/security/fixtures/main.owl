<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://example.org/main">
        <owl:imports rdf:resource="https://example.org/imported"/>
    </owl:Ontology>
    <owl:Class rdf:about="https://example.org/main#Person"/>
    <owl:Class rdf:about="https://example.org/main#Child">
        <rdfs:subClassOf rdf:resource="https://example.org/main#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/main#knows"/>
                <owl:someValuesFrom rdf:resource="https://example.org/imported#External"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/main#knows"/>
                <owl:allValuesFrom rdf:resource="https://example.org/imported#External"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:ObjectProperty rdf:about="https://example.org/main#knows">
        <rdfs:domain rdf:resource="https://example.org/main#Person"/>
        <rdfs:range rdf:resource="https://example.org/imported#External"/>
    </owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="https://example.org/main#name">
        <rdfs:domain rdf:resource="https://example.org/main#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
</rdf:RDF>
